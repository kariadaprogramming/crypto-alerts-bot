{
  "name": "crypto-alert-bot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node index.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop crypto-alerts-bot",
    "pm2:restart": "pm2 restart crypto-alerts-bot",
    "pm2:delete": "pm2 delete crypto-alerts-bot",
    "pm2:logs": "pm2 logs crypto-alerts-bot",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save",
    "service:install": "node install_service.js",
    "service:uninstall": "node uninstall_service.js",
    "service:start": "net start CryptoAlertsBot",
    "service:stop": "net stop CryptoAlertsBot",
    "background": "start_background.bat",
    "win:start": "powershell -ExecutionPolicy Bypass -File start_windows.ps1",
    "win:status": "powershell -ExecutionPolicy Bypass -File manage_bot.ps1 status",
    "win:logs": "powershell -ExecutionPolicy Bypass -File manage_bot.ps1 logs",
    "win:stop": "powershell -ExecutionPolicy Bypass -File manage_bot.ps1 stop",
    "win:restart": "powershell -ExecutionPolicy Bypass -File manage_bot.ps1 restart"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "axios": "^1.20.0",
    "dotenv": "^18.0.1",
    "groq-sdk": "^1.6.0",
    "pino": "^10.3.1",
    "playwright": "^1.63.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "node-windows": "^1.0.0-beta.8",
    "pm2": "^7.0.4"
  }
}
